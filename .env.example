# Lead capture — required for production
# Copy this file to .env.local for local testing.
# On Netlify, set the same names in Site configuration → Environment variables.
# Never prefix these with NEXT_PUBLIC_ — they must stay server-only.

# Neon Postgres pooled connection string from the Neon dashboard.
# Paste the value locally; do not commit it. Leave this line empty in git.
DATABASE_URL=

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that should receive every new lead.
LEAD_NOTIFY_EMAIL=

# Verified sender in Resend. For local tests you can use Resend's onboarding
# address, which can only send to the email on your Resend account:
# 1% Realtor Leads <beth.t@example.com>
LEAD_FROM_EMAIL=
